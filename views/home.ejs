<%- include('partials/header') %>

<div class="home2">
  <section class="hero2">
    <div class="wrap hero2-inner">
      <div class="hero2-copy">
        <% if (currentUser && currentUser.role === 'company') { %>
          <h1>Bugün <mark><%= stats.todayCount %> yeni</mark> talep var</h1>
          <p class="hero2-lead">Hizmet verdiğiniz alanlardaki işlere fiyatınızı yazın; müşteri kabul edince telefonlar karşılıklı açılır.</p>
          <div class="hero2-actions">
            <a class="btn btn-primary btn-lg" href="/dashboard/matches">Bana uygun talepler</a>
            <a class="btn btn-lg" href="/requests">Tüm talepler</a>
          </div>
        <% } else { %>
          <h1>İşini yaz,<br>firmalar <mark>yarışsın.</mark></h1>
          <p class="hero2-lead">Ne yaptıracağınızı anlatın, o alandaki firmalar fiyat ve süre göndersin. Ücretsiz; telefonunuz siz bir teklifi kabul edene kadar gizli kalır.</p>
          <form class="hero2-search" action="/requests/new" method="GET">
            <label class="visually-hidden" for="heroTitle">Yaptıracağınız iş</label>
            <input class="input" id="heroTitle" type="text" name="title" maxlength="200" placeholder="Ne yaptırmak istiyorsunuz?" autocomplete="off">
            <select class="select" name="city" aria-label="İl">
              <option value="">İl seçin</option>
              <% allCities.forEach(city => { %><option value="<%= city %>"><%= city %></option><% }) %>
            </select>
            <button class="btn btn-primary" type="submit">Teklif Al</button>
          </form>
          <% const quick = ['boya badana', 'evden eve nakliyat', 'koltuk yıkama', 'logo tasarımı', 'özel ders']; %>
          <p class="hero2-popular"><span>Sık arananlar:</span>
            <% quick.forEach(term => { %><a href="/requests?search=<%= encodeURIComponent(term) %>"><%= term %></a><% }) %>
          </p>
        <% } %>
        <ul class="hero2-proof">
          <li><strong><%= total %></strong> açık talep</li>
          <li><strong><%= stats.companyCount %></strong> firma</li>
          <% if (lastBidAt) { %><li>son teklif <strong><%= timeAgo(lastBidAt) %></strong></li><% } %>
        </ul>
      </div>

      <div class="hero2-art" aria-hidden="true">
        <img class="hero2-img hero2-img-a" src="/img/ilan/usta.jpg" alt="" width="640" height="480" fetchpriority="high">
        <img class="hero2-img hero2-img-b" src="/img/ilan/temizlik.jpg" alt="" width="640" height="480">
        <img class="hero2-img hero2-img-c" src="/img/ilan/tasima.jpg" alt="" width="640" height="480">
        <% if (board && board.length) { %>
          <div class="hero2-chip">
            <span><%= board[0].label %></span>
            <strong><%= budgetLabel({ min: board[0].low, max: board[0].high }) %></strong>
            <small>sitede verilen <%= board[0].count %> teklifin orta aralığı</small>
          </div>
        <% } %>
      </div>
    </div>
  </section>

  <section class="wrap home2-section" aria-labelledby="servicesTitle">
    <div class="home2-head">
      <div>
        <h2 id="servicesTitle">Popüler hizmetler</h2>
        <p>En çok talep açılan alanlar</p>
      </div>
      <a href="/kategoriler">Tüm kategoriler</a>
    </div>
    <ul class="service-grid">
      <% categoryTiles.slice(0, 8).forEach(category => { %>
        <li>
          <a class="service-card" href="<%= categoryUrl(category.name) %>">
            <img src="<%= thumb(category.image) %>" alt="" loading="lazy" decoding="async" width="240" height="180">
            <b><%= category.name %></b>
            <span><%= counts[category.name] ? counts[category.name] + ' açık talep' : 'İlk talebi siz verin' %></span>
          </a>
        </li>
      <% }) %>
    </ul>
  </section>

  <section class="wrap home2-section" aria-labelledby="latestTitle">
    <div class="home2-head">
      <div>
        <h2 id="latestTitle">Son Eklenen Talepler</h2>
        <p>Firmaların şu an teklif verdiği işler</p>
      </div>
      <a href="/requests">Tümünü gör<% if (total) { %> (<%= total %>)<% } %></a>
    </div>
    <% if (latest.length) { %>
      <%- include('partials/listing-table', { items: latest.slice(0, 8), adEvery: 0 }) %>
    <% } else { %>
      <div class="box empty">
        <h2>Henüz talep yok</h2>
        <p>İlk talebi siz verin, ilgili firmalara haber gitsin.</p>
        <a class="btn btn-primary" href="/requests/new">Talep Ver</a>
      </div>
    <% } %>
  </section>

  <% if (vitrin.featured.length) { %>
    <section class="wrap home2-section" aria-labelledby="vitrinTitle">
      <div class="home2-head">
        <div>
          <h2 id="vitrinTitle">Vitrin</h2>
          <p>Bu hafta en çok bakılan fotoğraflı talepler</p>
        </div>
        <a href="/requests?photos=on&sort=views">Tümünü gör</a>
      </div>
      <%- include('partials/showcase-grid', { items: vitrin.featured.slice(0, 5) }) %>
    </section>
  <% } %>

  <section class="wrap home2-section" aria-labelledby="howTitle">
    <div class="home2-head">
      <div>
        <h2 id="howTitle">Nasıl işler?</h2>
        <p>Üç adımda doğru firmayı bulun</p>
      </div>
      <a href="/yardim">Sık sorulanlar</a>
    </div>
    <ol class="steps">
      <li><h3>İşinizi anlatın</h3><p>Birkaç cümle yeterli. İsterseniz fotoğraf ve bütçe ekleyin; telefonunuz gizli kalır.</p></li>
      <li><h3>Teklifleri karşılaştırın</h3><p>O alandaki firmalar fiyat ve süre yazar. Aklınıza takılanı mesajla sorarsınız.</p></li>
      <li><h3>Birini seçin</h3><p>Kabul edince telefonlar karşılıklı açılır. İş bitince yorumunuz sıradaki müşteriye yol gösterir.</p></li>
    </ol>
  </section>

  <% if (board && board.length) { %>
    <section class="wrap home2-section" aria-labelledby="pricesTitle">
      <div class="price-teaser">
        <div>
          <h2 id="pricesTitle">Hangi iş kaça yapılıyor?</h2>
          <p>Rakamlar sitede verilen gerçek tekliflerden: son altı ayda verilen tekliflerin ortadaki yarısı. Talep vermeden önce bütçenizi buna göre düşünebilirsiniz.</p>
          <a class="btn" href="/fiyat-rehberi">Fiyat rehberini aç</a>
        </div>
        <ul class="price-rows">
          <% board.slice(0, 6).forEach(row => { %>
            <li>
              <a href="/requests?search=<%= encodeURIComponent(row.search) %>&amp;category=<%= encodeURIComponent(row.category) %>"><%= row.label %></a>
              <span><%= budgetLabel({ min: row.low, max: row.high }) %></span>
            </li>
          <% }) %>
        </ul>
      </div>
    </section>
  <% } %>

  <section class="wrap home2-section home2-sponsors" aria-label="Reklamlar">
    <div class="sponsor-grid">
      <%- include('partials/ad', { format: 'side' }) %>
      <%- include('partials/ad', { format: 'side' }) %>
      <%- include('partials/ad', { format: 'side' }) %>
    </div>
  </section>

  <% if (latestReviews.length) { %>
    <section class="wrap home2-section" aria-labelledby="reviewsTitle">
      <div class="home2-head">
        <div>
          <h2 id="reviewsTitle">Son Yorumlar</h2>
          <p>İşi tamamlanan müşteriler yazdı</p>
        </div>
        <a href="/companies">Firma rehberi</a>
      </div>
      <div class="review-grid">
        <% latestReviews.forEach(review => { %>
          <figure class="review-card">
            <div class="review-stars" role="img" aria-label="<%= review.rating %> üzerinden 5 puan">
              <% for (let n = 1; n <= 5; n += 1) { %><%- icon('star', { size: 14, class: n <= review.rating ? 'star' : 'star-empty' }) %><% } %>
            </div>
            <blockquote><%= truncate(review.comment, 160) %></blockquote>
            <figcaption><%= shortName(review.customer.name) %>, <a href="/companies/<%= review.company._id %>"><%= review.company.companyName || review.company.name %></a> hakkında</figcaption>
          </figure>
        <% }) %>
      </div>
    </section>
  <% } %>

  <section class="wrap home2-section" id="recentBox" hidden aria-labelledby="recentTitle">
    <div class="home2-head"><div><h2 id="recentTitle">Son baktıklarınız</h2></div></div>
    <div class="showcase-grid columns-4" id="recentGrid"></div>
  </section>

  <% if (!currentUser || currentUser.role === 'company') { %>
    <section class="firm-band">
      <div class="wrap firm-band-inner">
        <div>
          <h2>Firmanız mı var?</h2>
          <p>Müşteri aramayın; iş arayanların taleplerine fiyatınızı yazın. Başlangıç paketi ücretsiz, ayda 10 teklif.</p>
        </div>
        <% if (currentUser) { %>
          <a class="btn btn-primary btn-lg" href="/profile">Firma sayfamı düzenle</a>
        <% } else { %>
          <a class="btn btn-primary btn-lg" href="/register?role=company">Firma hesabı aç</a>
        <% } %>
      </div>
    </section>
  <% } %>
</div>

<%- include('partials/footer') %>

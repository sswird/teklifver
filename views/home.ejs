<%- include('partials/header') %>

<%
  // Vitrin satırları yarım kalmasın: beşin katı kadar fotoğraflı talep gösterilir.
  const vitrinCount = showcase.length >= 15 ? 15 : showcase.length >= 10 ? 10 : Math.min(showcase.length, 5);
%>
<div class="wrap page">
  <div class="layout-home">
    <aside class="home-left" aria-label="Kategoriler">
      <section class="box cat-box">
        <div class="box-head">Kategoriler <a href="/kategoriler">Tümü</a></div>
        <ul class="cat-tree">
          <% allCategories.forEach(category => { %>
            <li>
              <a class="cat-tree-main" href="<%= categoryUrl(category.name) %>"><span><%= category.name %></span> <span class="count">(<%= counts[category.name] || 0 %>)</span></a>
              <% if (category.subs && category.subs.length) { %>
                <ul class="cat-tree-subs">
                  <% category.subs.slice(0, 4).forEach(([label, term]) => { %>
                    <li><a href="/requests?category=<%= encodeURIComponent(category.name) %>&search=<%= encodeURIComponent(term.trim()) %>"><%= label %></a></li>
                  <% }) %>
                </ul>
              <% } %>
            </li>
          <% }) %>
        </ul>
      </section>

      <section class="box desktop-only">
        <div class="box-head">Kısayollar</div>
        <ul class="side-list">
          <li><a href="/requests?period=1">Son 24 saat <% if (stats.todayCount) { %><span class="count"><%= stats.todayCount %></span><% } %></a></li>
          <li><a href="/requests?noBids=on">Teklif almamış talepler</a></li>
          <li><a href="/requests?photos=on">Fotoğraflı talepler</a></li>
          <li><a href="/requests?sort=deadline">Süresi yaklaşanlar</a></li>
          <li><a href="/fiyat-rehberi">Fiyat rehberi</a></li>
          <li><a href="/companies">Firma rehberi</a></li>
        </ul>
      </section>

      <% if (cityRows.length) { %>
        <section class="box desktop-only">
          <div class="box-head">İllere Göre <a href="/iller">Tümü</a></div>
          <ul class="side-list">
            <% cityRows.slice(0, 10).forEach(row => { %>
              <li><a href="<%= cityUrl(row._id) %>"><%= row._id %> <span class="count"><%= row.total %></span></a></li>
            <% }) %>
          </ul>
        </section>
      <% } %>
    </aside>

    <div class="home-center">
      <% if (currentUser && currentUser.role === 'company') { %>
        <section class="composer">
          <h1>Bugün <%= stats.todayCount %> yeni talep var</h1>
          <div class="composer-row">
            <a class="btn" href="/dashboard/matches">Bana uygun talepleri göster</a>
          </div>
          <p class="composer-note">Hizmet verdiğiniz kategorileri <a href="/profile">hesap bilgilerinizden</a> değiştirebilirsiniz.</p>
        </section>
      <% } else { %>
        <section class="composer">
          <h1>İşini yaz, firmalar yarışsın.</h1>
          <form action="/requests/new" method="GET">
            <div class="composer-row">
              <input class="input" type="text" name="title" maxlength="200" placeholder="Ne yaptırmak istiyorsunuz? Örneğin: 2+1 daire boyanacak" aria-label="Yaptıracağınız iş" autocomplete="off">
              <select class="select" name="city" aria-label="İl">
                <option value="">İl seçin</option>
                <% allCities.forEach(city => { %><option value="<%= city %>"><%= city %></option><% }) %>
              </select>
              <button class="btn" type="submit">Teklif Al</button>
            </div>
          </form>
          <% const quick = ['boya badana', 'evden eve nakliyat', 'koltuk yıkama', 'logo', 'özel ders']; %>
          <p class="composer-quick">Çok arananlar:
            <% quick.forEach((term, index) => { %><a href="/requests?search=<%= encodeURIComponent(term) %>"><%= term %></a><%= index < quick.length - 1 ? ', ' : '' %><% }) %>
          </p>
          <ul class="composer-stats">
            <li><b><%= total %></b> açık talep</li>
            <li><b><%= stats.companyCount %></b> firma</li>
            <li><b><%= stats.bidCount %></b> teklif verildi</li>
            <% if (lastBidAt) { %><li>son teklif <strong><%= timeAgo(lastBidAt) %></strong></li><% } %>
          </ul>
        </section>
      <% } %>

      <% if (vitrinCount) { %>
        <section class="box vitrin-box">
          <div class="box-head">Anasayfa Vitrini <a href="/requests?photos=on&sort=views">Tüm vitrin talepleri</a></div>
          <%- include('partials/showcase-grid', { items: showcase.slice(0, vitrinCount) }) %>
        </section>
      <% } %>

      <%- include('partials/price-board', { placement: 'feed' }) %>

      <section class="box">
        <div class="box-head">Son Eklenen Talepler <% if (total) { %><a href="/requests">Tümü (<%= total %>)</a><% } %></div>
        <% if (latest.length) { %>
          <%- include('partials/listing-table', { items: latest, adEvery: 6 }) %>
        <% } else { %>
          <div class="empty">
            <h2>Henüz talep yok</h2>
            <p>İlk talebi siz verin, ilgili firmalara haber gitsin.</p>
            <a class="btn btn-primary" href="/requests/new">Talep Ver</a>
          </div>
        <% } %>
      </section>

      <section class="box" id="recentBox" hidden>
        <div class="box-head">Son Baktıklarınız</div>
        <div class="showcase-grid" id="recentGrid"></div>
      </section>

      <% if (latestReviews.length) { %>
        <section class="box">
          <div class="box-head">Son Yorumlar <a href="/companies">Firma rehberi</a></div>
          <div class="review-grid">
            <% latestReviews.forEach(review => { %>
              <figure class="review-card">
                <div class="review-stars" role="img" aria-label="<%= review.rating %> üzerinden 5 puan">
                  <% for (let n = 1; n <= 5; n += 1) { %><%- icon('star', { size: 12, class: n <= review.rating ? 'star' : 'star-empty' }) %><% } %>
                </div>
                <blockquote><%= truncate(review.comment, 160) %></blockquote>
                <figcaption><%= shortName(review.customer.name) %>, <a href="/companies/<%= review.company._id %>"><%= review.company.companyName || review.company.name %></a> hakkında</figcaption>
              </figure>
            <% }) %>
          </div>
        </section>
      <% } %>

      <section class="box">
        <div class="box-head">Nasıl İşliyor?</div>
        <ol class="how-steps">
          <li><b>İşinizi yazın.</b> Ne, nerede, ne zaman? İsterseniz fotoğraf ve bütçe ekleyin.</li>
          <li><b>Teklifleri karşılaştırın.</b> Firmalar fiyat ve süre yazar; puan ve yorumları yan yana görürsünüz.</li>
          <li><b>Seçin, anlaşın.</b> Birini seçince telefonlar karşılıklı açılır. Ödemede dikkat edeceklerinizi <a href="/guvenli-hizmet">burada anlattık</a>.</li>
        </ol>
      </section>
    </div>

    <aside class="home-right" aria-label="Fiyatlar, firmalar ve öneriler">
      <%- include('partials/price-board', { placement: 'rail' }) %>
      <% if (!currentUser || currentUser.role === 'company') { %>
        <section class="box">
          <div class="box-head">Firmanız mı Var?</div>
          <div class="rail-note">
            <% if (currentUser) { %>
              <p>Sayfanızı doldurun, müşteriler sizi firma rehberinde bulsun.</p>
              <a class="btn btn-block" href="/profile">Firma Sayfamı Düzenle</a>
            <% } else { %>
              <p>Müşteri aramayın, iş arayanların taleplerine fiyatınızı yazın. Üyelik ücretsiz.</p>
              <a class="btn btn-navy btn-block" href="/register?role=company">Firma Hesabı Aç</a>
            <% } %>
          </div>
        </section>
      <% } %>

      <% if (closing.length) { %>
        <section class="box">
          <div class="box-head">Süresi Dolmak Üzere</div>
          <ul class="deadline-list">
            <% closing.slice(0, 5).forEach(item => { const left = daysLeft(item.deadline); %>
              <li>
                <a href="/requests/<%= item._id %>"><%= truncate(item.title, 60) %></a>
                <span><span class="<%= left <= 3 ? 'is-close' : '' %>" style="display:inline"><%= left <= 1 ? 'Bugün bitiyor' : left + ' gün kaldı' %></span><%= item.city ? ', ' + item.city : '' %></span>
              </li>
            <% }) %>
          </ul>
        </section>
      <% } %>

      <%- include('partials/ad', { format: 'side' }) %>

      <% if (topCompanies.length) { %>
        <section class="box">
          <div class="box-head">Puanı Yüksek Firmalar <a href="/companies">Rehber</a></div>
          <ul class="company-mini">
            <% topCompanies.forEach(company => { %>
              <li>
                <a href="/companies/<%= company._id %>"><%= company.companyName || company.name %></a>
                <span><%- icon('star', { size: 11, class: 'star' }) %> <%= ratingLabel(company.rating) %> (<%= company.ratingCount %> yorum)</span>
              </li>
            <% }) %>
          </ul>
        </section>
      <% } %>

      <%- include('partials/ad', { format: 'side' }) %>
    </aside>
  </div>
</div>

<%- include('partials/footer') %>

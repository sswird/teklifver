<%- include('partials/header') %>

<div class="wrap page">
  <div class="home-hero">
    <% if (currentUser && currentUser.role === 'company') { %>
      <section class="composer">
        <h1>Bugün <%= stats.todayCount %> yeni talep var</h1>
        <div class="composer-row">
          <a class="btn" href="/dashboard/matches">Bana uygun talepleri göster</a>
        </div>
        <p class="composer-note">Hizmet verdiğiniz kategorileri <a href="/profile">hesap bilgilerinizden</a> değiştirebilirsiniz.</p>
      </section>
    <% } else { %>
      <section class="composer">
        <h1>İşini yaz, firmalar yarışsın.</h1>
        <p class="composer-lead">Yaptıracağınız işi birkaç kelimeyle yazın; o alandaki firmalar fiyat ve süre göndersin.</p>
        <form action="/requests/new" method="GET">
          <div class="composer-row">
            <input class="input" type="text" name="title" maxlength="200" placeholder="Örneğin: 2+1 daire boyanacak" aria-label="Yaptıracağınız iş" autocomplete="off">
            <select class="select" name="city" aria-label="İl">
              <option value="">İl seçin</option>
              <% allCities.forEach(city => { %><option value="<%= city %>"><%= city %></option><% }) %>
            </select>
            <button class="btn" type="submit">Teklif Al</button>
          </div>
        </form>
        <p class="composer-note">Talep vermek ücretsiz. Telefon numaranız, siz bir teklifi kabul edene kadar firmalara görünmez.</p>
        <% const quick = ['boya', 'evden eve nakliyat', 'koltuk yıkama', 'logo', 'özel ders']; %>
        <p class="composer-quick">Çok arananlar:
          <% quick.forEach((term, index) => { %><a href="/requests?search=<%= encodeURIComponent(term) %>"><%= term %></a><%= index < quick.length - 1 ? ', ' : '' %><% }) %>
        </p>
      </section>
    <% } %>
    <% if (stats.todayCount || lastBidAt) { %>
      <p class="pulse-line">
        <span class="pulse-dot" aria-hidden="true"></span>
        <span class="pulse-text"><% if (stats.todayCount) { %>Son 24 saatte <strong><%= stats.todayCount %></strong> yeni talep<% } %><% if (stats.todayCount && lastBidAt) { %>, <% } %><% if (lastBidAt) { %>son teklif <strong><%= timeAgo(lastBidAt) %></strong> geldi<% } %>.</span>
        <a href="/requests?period=1">Yeni talepleri gör</a>
      </p>
    <% } %>
  </div>

  <section class="cat-tiles" aria-labelledby="catTilesTitle">
    <div class="section-head">
      <h2 id="catTilesTitle">Ne yaptırmak istiyorsunuz?</h2>
      <a href="/kategoriler">Tüm kategoriler</a>
    </div>
    <ul class="cat-tile-list">
      <% categoryTiles.forEach(category => { %>
        <li>
          <a class="cat-tile" href="<%= categoryUrl(category.name) %>">
            <img src="<%= thumb(category.image) %>" alt="" loading="lazy" decoding="async" width="240" height="180">
            <span class="cat-tile-label">
              <b><%= category.name %></b>
              <span><%= counts[category.name] ? counts[category.name] + ' açık talep' : 'Talep verin' %></span>
            </span>
          </a>
        </li>
      <% }) %>
      <li>
        <a class="cat-tile cat-tile-all" href="/kategoriler">
          <span class="cat-tile-label"><b>Tüm kategoriler</b><span><%= allCategories.length %> alan, <%= total %> açık talep</span></span>
        </a>
      </li>
    </ul>
  </section>

  <% if (vitrin.featured.length) { %>
    <section class="box vitrin" aria-labelledby="vitrinTitle">
      <div class="box-head vitrin-head">
        <span id="vitrinTitle">Vitrin</span>
        <div class="vitrin-tabs" role="tablist" aria-label="Vitrin" data-tabset>
          <button class="vitrin-tab" type="button" role="tab" id="vitrinTabFeatured" aria-controls="vitrinFeatured" aria-selected="true">Çok bakılanlar</button>
          <% if (vitrin.urgent.length) { %><button class="vitrin-tab" type="button" role="tab" id="vitrinTabUrgent" aria-controls="vitrinUrgent" aria-selected="false" tabindex="-1">Acil işler <span class="tab-count"><%= vitrin.urgent.length %></span></button><% } %>
          <% if (vitrin.fresh.length) { %><button class="vitrin-tab" type="button" role="tab" id="vitrinTabFresh" aria-controls="vitrinFresh" aria-selected="false" tabindex="-1">Yeni gelenler</button><% } %>
        </div>
        <a href="/requests?photos=on&sort=views">Tümünü Gör</a>
      </div>
      <div class="vitrin-panel" id="vitrinFeatured" role="tabpanel" aria-labelledby="vitrinTabFeatured">
        <%- include('partials/showcase-grid', { items: vitrin.featured }) %>
      </div>
      <% if (vitrin.urgent.length) { %>
        <div class="vitrin-panel" id="vitrinUrgent" role="tabpanel" aria-labelledby="vitrinTabUrgent" hidden>
          <%- include('partials/showcase-grid', { items: vitrin.urgent }) %>
        </div>
      <% } %>
      <% if (vitrin.fresh.length) { %>
        <div class="vitrin-panel" id="vitrinFresh" role="tabpanel" aria-labelledby="vitrinTabFresh" hidden>
          <%- include('partials/showcase-grid', { items: vitrin.fresh }) %>
        </div>
      <% } %>
    </section>
  <% } %>

  <div class="layout-home">
    <div class="home-center">
      <%- include('partials/price-board', { placement: 'feed' }) %>

      <nav class="quick-filters" aria-label="Hızlı filtreler">
        <a class="quick-chip" href="/requests?period=1">Son 24 saat<% if (stats.todayCount) { %> <b><%= stats.todayCount %></b><% } %></a>
        <a class="quick-chip" href="/requests?noBids=on">Teklif bekleyenler</a>
        <a class="quick-chip" href="/requests?photos=on">Fotoğraflı</a>
        <a class="quick-chip" href="/requests?sort=deadline">Süresi yaklaşan</a>
        <a class="quick-chip" href="/requests?sort=budget_high">Bütçesi yüksek</a>
        <a class="quick-chip" href="/fiyat-rehberi">Fiyat rehberi</a>
      </nav>

      <section class="box">
        <div class="box-head">Son Eklenen Talepler <% if (total) { %><a href="/requests">Tümü (<%= total %>)</a><% } %></div>
        <% if (latest.length) { %>
          <%- include('partials/listing-table', { items: latest, adEvery: 6 }) %>
          <div class="feed-more"><a class="btn btn-block" href="/requests">Tüm talepleri gör<% if (total) { %> (<%= total %>)<% } %></a></div>
        <% } else { %>
          <div class="empty">
            <h2>Henüz talep yok</h2>
            <p>İlk talebi siz verin, ilgili firmalara haber gitsin.</p>
            <a class="btn btn-primary" href="/requests/new">Talep Ver</a>
          </div>
        <% } %>
      </section>

      <section class="box" id="recentBox" hidden>
        <div class="box-head">Son Baktıklarınız</div>
        <div class="showcase-grid columns-4" id="recentGrid"></div>
      </section>

      <% if (latestReviews.length) { %>
        <section class="box">
          <div class="box-head">Son Yorumlar</div>
          <div class="review-grid">
            <% latestReviews.forEach(review => { %>
              <figure class="review-card">
                <div class="review-stars" role="img" aria-label="<%= review.rating %> üzerinden 5 puan">
                  <% for (let n = 1; n <= 5; n += 1) { %><%- icon('star', { size: 12, class: n <= review.rating ? 'star' : 'star-empty' }) %><% } %>
                </div>
                <blockquote><%= truncate(review.comment, 160) %></blockquote>
                <figcaption><%= shortName(review.customer.name) %>, <a href="/companies/<%= review.company._id %>"><%= review.company.companyName || review.company.name %></a> hakkında</figcaption>
              </figure>
            <% }) %>
          </div>
        </section>
      <% } %>

      <section class="box">
        <div class="box-head">Nasıl İşliyor?</div>
        <p class="how-prose">İşi anlatırsınız, isterseniz fotoğraf ve bütçe eklersiniz. O alanda çalışan firmalar fiyat ve süre yazar. Teklifleri yan yana görür, aklınıza takılanı mesajla sorarsınız. Birini seçince telefonlar karşılıklı açılır, iş bitince yorumunuzu yazarsınız. Ödemede nelere dikkat edeceğinizi <a href="/guvenli-hizmet">şurada anlattık</a>.</p>
      </section>
    </div>

    <aside class="home-right" aria-label="Fiyatlar, hareketler ve firmalar">
      <%- include('partials/price-board', { placement: 'rail' }) %>

      <% if (activity.length) { %>
        <section class="box activity">
          <div class="box-head">Şu an TeklifVer'de</div>
          <ol class="activity-list">
            <% activity.forEach(item => { %>
              <li class="activity-item is-<%= item.type %>">
                <span class="activity-who"><strong><%= item.who %></strong> <%= item.verb %></span>
                <a href="<%= item.url %>"><%= truncate(item.title, 58) %></a>
                <time datetime="<%= new Date(item.at).toISOString() %>"><%= timeAgo(item.at) %></time>
              </li>
            <% }) %>
          </ol>
        </section>
      <% } %>

      <% if (!currentUser || currentUser.role === 'company') { %>
        <section class="box">
          <div class="box-head">Firmanız mı Var?</div>
          <div class="rail-note">
            <% if (currentUser) { %>
              <p>Sayfanızı doldurun, müşteriler sizi firma rehberinde bulsun.</p>
              <a class="btn btn-block" href="/profile">Firma Sayfamı Düzenle</a>
            <% } else { %>
              <p>Müşteri aramayın, iş arayanların taleplerine fiyatınızı yazın. Üyelik ücretsiz.</p>
              <a class="btn btn-navy btn-block" href="/register?role=company">Firma Hesabı Aç</a>
            <% } %>
          </div>
        </section>
      <% } %>

      <% if (closing.length) { %>
        <section class="box">
          <div class="box-head">Süresi Dolmak Üzere</div>
          <ul class="deadline-list">
            <% closing.slice(0, 5).forEach(item => { const left = daysLeft(item.deadline); %>
              <li>
                <a href="/requests/<%= item._id %>"><%= truncate(item.title, 60) %></a>
                <span><span class="<%= left <= 3 ? 'is-close' : '' %>" style="display:inline"><%= left <= 1 ? 'Bugün bitiyor' : left + ' gün kaldı' %></span><%= item.city ? ', ' + item.city : '' %></span>
              </li>
            <% }) %>
          </ul>
        </section>
      <% } %>

      <%- include('partials/ad', { format: 'side' }) %>

      <% if (topCompanies.length) { %>
        <section class="box">
          <div class="box-head">Puanı Yüksek Firmalar <a href="/companies">Rehber</a></div>
          <ul class="company-mini">
            <% topCompanies.forEach(company => { %>
              <li>
                <a href="/companies/<%= company._id %>"><%= company.companyName || company.name %></a>
                <span><%- icon('star', { size: 11, class: 'star' }) %> <%= ratingLabel(company.rating) %> (<%= company.ratingCount %> yorum)</span>
              </li>
            <% }) %>
          </ul>
        </section>
      <% } %>

      <% if (cityRows.length) { %>
        <section class="box">
          <div class="box-head">İllere Göre <a href="/iller">Tümü</a></div>
          <ul class="side-list city-list">
            <% cityRows.slice(0, 10).forEach(row => { %>
              <li><a href="<%= cityUrl(row._id) %>"><%= row._id %> <span class="count"><%= row.total %></span></a></li>
            <% }) %>
          </ul>
        </section>
      <% } %>

      <%- include('partials/ad', { format: 'side' }) %>
    </aside>
  </div>
</div>

<%- include('partials/footer') %>

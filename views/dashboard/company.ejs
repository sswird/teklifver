<%- include('../partials/header') %>

<div class="wrap page">
  <div class="layout">
    <aside><%- include('../partials/panel-menu') %></aside>

    <section class="box">
      <div class="box-head">Tekliflerim (<%= myBids.length %>) <a href="/requests">Teklif Verilecek İşler</a></div>
      <%- include('../partials/profile-checklist') %>

      <div class="summary">
        <div><strong><%= stats.pendingBids %></strong><span>Bekleyen</span></div>
        <div><strong><%= stats.acceptedBids %></strong><span>Kabul edilen</span></div>
        <div><strong><%= stats.rejectedBids %></strong><span>Reddedilen</span></div>
        <div><strong><%= money(stats.totalEarnings) %></strong><span>Kabul edilen tutar</span></div>
      </div>
      <p class="box-note">
        Firma sayfanız <strong><%= profileViews %></strong> kez görüntülendi. <a href="/companies/<%= currentUser.id %>">Sayfamı gör</a>
        <span class="note-sep">·</span>
        <% if (allowance.limited) { %>Bu ay <strong><%= allowance.left %></strong> teklif hakkınız kaldı.<% } else { %><%= allowance.plan.name %> paketi: teklif sınırı yok.<% } %>
        <a href="/dashboard/plans">Paketler</a>
      </p>

      <% if (myBids.length === 0) { %>
        <div class="empty">
          <h2>Henüz teklif vermediniz</h2>
          <a class="btn btn-primary" href="/requests">Teklif Verilecek İşler</a>
        </div>
      <% } else { %>
        <div class="tabs" role="tablist" data-tabs="bidRows">
          <button class="tab" type="button" role="tab" aria-selected="true" data-filter="all">Tümü</button>
          <button class="tab" type="button" role="tab" aria-selected="false" data-filter="pending">Bekleyen</button>
          <button class="tab" type="button" role="tab" aria-selected="false" data-filter="accepted">Kabul edilen</button>
          <button class="tab" type="button" role="tab" aria-selected="false" data-filter="rejected">Reddedilen</button>
        </div>

        <table class="listing-table" id="bidRows">
          <thead>
            <tr>
              <th class="col-photo"><span class="visually-hidden">Fotoğraf</span></th>
              <th>Talep</th>
              <th class="col-budget">Teklifim</th>
              <th class="col-date">Süre</th>
              <th class="col-date">Tarih</th>
              <th class="col-status">Durum</th>
            </tr>
          </thead>
          <tbody>
            <% myBids.forEach(bid => { if (!bid.request) return; %>
              <tr data-status="<%= bid.status %>">
                <td class="col-photo">
                  <a class="thumb" href="/requests/<%= bid.request._id %>" tabindex="-1" aria-hidden="true">
                    <% if (bid.request.images && bid.request.images.length) { %>
                      <img src="<%= bid.request.images[0] %>" alt="" loading="lazy">
                    <% } else { %>
                      <span class="no-photo">Fotoğraf yok</span>
                    <% } %>
                  </a>
                </td>
                <td>
                  <a class="listing-title" href="/requests/<%= bid.request._id %>"><%= bid.request.title %></a>
                  <div class="listing-sub"><%= bid.request.customer ? (bid.status === 'accepted' ? bid.request.customer.name : shortName(bid.request.customer.name)) : '' %> · <%= placeLabel(bid.request) %></div>
                </td>
                <td class="col-budget"><%= money(bid.amount) %></td>
                <td class="col-date"><%= bid.deliveryTime %> gün</td>
                <td class="col-date"><%- dateCell(bid.createdAt) %></td>
                <td class="col-status"><%- include('../partials/status', { status: bidStatus[bid.status] }) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
        <p class="tabs-empty" hidden>Bu durumda teklifiniz yok.</p>
      <% } %>
    </section>
  </div>
</div>

<%- include('../partials/footer') %>

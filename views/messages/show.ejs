<%- include('../partials/header') %>

<% const otherName = other.companyName || shortName(other.name); %>

<div class="wrap page">
  <div class="layout">
    <aside class="desktop-only"><%- include('../partials/panel-menu') %></aside>

    <section class="box">
      <div class="box-head">
        <span>
          <a href="/messages" style="font-size:13px;font-weight:bold">Mesajlarım</a> &rsaquo; <%= otherName %>
        </span>
        <% if (other.role === 'company') { %><a href="/companies/<%= other._id %>">Firma Sayfası</a><% } %>
      </div>

      <a class="thread-request" href="/requests/<%= request._id %>">
        <span class="thumb thumb-sm">
          <% if (request.images && request.images.length) { %>
            <img src="<%= request.images[0] %>" alt="">
          <% } else { %>
            <span class="no-photo"></span>
          <% } %>
        </span>
        <span>
          <strong><%= request.title %></strong>
          <span class="listing-sub">Talep No: <%= request.no %> · <%= placeLabel(request) %></span>
          <span class="thread-price"><%= budgetLabel(request.budget) %></span>
        </span>
      </a>

      <% const threadBid = locals.bid; if (threadBid) { const mine = currentUser.role === 'company'; %>
        <p class="thread-bid">
          <span><%= mine ? 'Teklifiniz' : 'Firmanın teklifi' %>: <strong><%= money(threadBid.amount) %></strong> · <%= threadBid.deliveryTime %> gün</span>
          <%- include('../partials/status', { status: bidStatus[threadBid.status] }) %>
          <a href="/requests/<%= request._id %>#teklif-<%= threadBid._id %>"><%= mine ? 'Teklifinize git' : 'Teklife git' %></a>
        </p>
      <% } %>

      <div class="thread" id="thread" data-poll="/messages/<%= request._id %>/<%= other._id %>/new" data-last="<%= messages.length ? messages[messages.length - 1]._id : '' %>">
        <p class="thread-empty" <%= messages.length ? 'hidden' : '' %>>Henüz mesaj yok. İlk mesajı siz yazın.</p>
        <% messages.forEach(message => { const mine = message.sender.toString() === currentUser.id; %>
          <div class="msg <%= mine ? 'msg-mine' : '' %>">
            <% if (message.image) { %>
              <a class="msg-image" href="<%= message.image %>" target="_blank" rel="noopener"><img src="<%= thumb(message.image) %>" alt="Gönderilen fotoğraf" loading="lazy" width="200" height="150"></a>
            <% } %>
            <% if (message.content) { %><div class="msg-text"><%= message.content %></div><% } %>
            <div class="msg-time"><%= formatDateTime(message.createdAt) %></div>
          </div>
        <% }) %>
      </div>

      <form class="thread-form" action="/messages/<%= request._id %>/<%= other._id %>" method="POST" enctype="multipart/form-data">
        <div class="quick-replies" aria-label="Hazır yanıtlar">
          <% (currentUser.role === 'company'
            ? ['Merhaba, talebinizle ilgili birkaç sorum olacak.', 'Keşif için uygun olduğunuz bir gün var mı?', 'Teklifimi inceleyebildiniz mi?', 'Ölçü veya fotoğraf paylaşabilir misiniz?']
            : ['Merhaba, teklifiniz için teşekkürler.', 'Fiyata neler dahil?', 'Ne zaman başlayabilirsiniz?', 'Benzer işlerinizden örnek görebilir miyim?']
          ).forEach(text => { %>
            <button class="quick-reply" type="button" data-quick-reply="<%= text %>"><%= text %></button>
          <% }) %>
        </div>

        <label class="visually-hidden" for="messageContent">Mesajınız</label>
        <textarea class="textarea" id="messageContent" name="content" rows="3" maxlength="<%= maxLength %>" placeholder="Mesajınızı yazın"></textarea>
        <div class="thread-form-foot">
          <label class="attach-button">
            <input class="visually-hidden" type="file" id="messageImage" name="images" accept="image/jpeg,image/png,image/gif,image/webp">
            <%- icon('camera', { size: 15 }) %><span data-attach-label>Fotoğraf ekle</span>
          </label>
          <span class="muted small thread-hint">Ctrl + Enter ile gönderebilirsiniz.</span>
          <button class="btn btn-primary" type="submit">Gönder</button>
        </div>
      </form>
    </section>
  </div>
</div>



<%- include('../partials/footer') %>

<%
  // Klasik ilan tablosu: Başlık | Bütçe | Teklif | Tarih | İl / İlçe.
  // compact: dar sütunda (ana sayfa) tarih ve yer başlığın altındaki satıra geçer.
  // Statik ön izleme satırları buradan alır: <tr> ile col-photo hücresi bitişik kalmalı.
  const adEvery = locals.adEvery || 0;
  const compact = Boolean(locals.compact);
  const columns = compact ? 5 : 7;
%>
<table class="listing-table is-classic <%= compact ? 'is-compact' : '' %>">
  <thead>
    <tr>
      <th class="col-photo"><span class="visually-hidden">Fotoğraf</span></th>
      <th>Talep Başlığı</th>
      <% const heads = locals.sortHeads || null; %>
      <th class="col-budget"<% if (heads && heads.budget.dir) { %> aria-sort="<%= heads.budget.dir %>"<% } %>><% if (heads) { %><a class="sort-head <%= heads.budget.dir ? 'is-' + heads.budget.dir : '' %>" href="<%= heads.budget.href %>" data-sort-head="budget">Bütçe</a><% } else { %>Bütçe<% } %></th>
      <th class="col-bids"<% if (heads && heads.bids.dir) { %> aria-sort="<%= heads.bids.dir %>"<% } %>><% if (heads) { %><a class="sort-head <%= heads.bids.dir ? 'is-' + heads.bids.dir : '' %>" href="<%= heads.bids.href %>" data-sort-head="bids">Teklif</a><% } else { %>Teklif<% } %></th>
      <% if (!compact) { %>
        <th class="col-date"<% if (heads && heads.date.dir) { %> aria-sort="<%= heads.date.dir %>"<% } %>><% if (heads) { %><a class="sort-head <%= heads.date.dir ? 'is-' + heads.date.dir : '' %>" href="<%= heads.date.href %>" data-sort-head="date">Tarih</a><% } else { %>Tarih<% } %></th>
        <th class="col-place">İl / İlçe</th>
      <% } %>
      <th class="col-fav"><span class="visually-hidden">Favori</span></th>
    </tr>
  </thead>
  <tbody>
    <% items.forEach((item, index) => { const budget = budgetLabel(item.budget); %>
      <% if (adEvery && index > 0 && index % adEvery === 0) { %>
        <tr class="ad-row"><td colspan="<%= columns %>"><%- include('ad', { format: 'inline' }) %></td></tr>
      <% } %>
      <tr>
        <td class="col-photo">
          <a class="thumb" href="/requests/<%= item._id %>" tabindex="-1" aria-hidden="true">
            <% if (item.images && item.images.length) { %>
              <img src="<%= thumb(item.images[0]) %>" alt="" loading="lazy" decoding="async" width="240" height="180">
              <% if (item.images.length > 1) { %><span class="photo-count"><%- icon('camera', { size: 10 }) %><%= item.images.length %></span><% } %>
            <% } else { %>
              <span class="no-photo is-placeholder" data-cat="<%= item.category %>">Fotoğraf yok</span>
            <% } %>
          </a>
        </td>
        <td class="col-main">
          <a class="listing-title" href="/requests/<%= item._id %>"><%= truncate(item.title, 90) %></a>
          <% if (isUrgent(item)) { %><span class="label label-urgent">ACİL</span><% } %>
          <% if (isFresh(item)) { %><span class="label label-new">YENİ</span><% } %>
          <% if (item.description) { %><p class="listing-snippet"><%= truncate(item.description.replace(/\s+/g, ' '), 140) %></p><% } %>
          <div class="listing-sub">
            <span><%= item.category %></span>
            <% if (compact) { %><span class="listing-place"><%= placeLabel(item) %></span><span title="<%= formatDate(item.createdAt) %>"><%= timeAgo(item.createdAt) %></span><% } %>
          </div>
        </td>
        <td class="col-budget">
          <% if (budget === 'Belirtilmemiş') { %>
            <span class="price-tag is-open">Belirtilmemiş</span>
          <% } else { %>
            <span class="price-tag"><%= budget %></span>
          <% } %>
        </td>
        <td class="col-bids"><span class="listing-bids"><b><%= item.bidCount %></b> <span class="bids-word">teklif</span></span></td>
        <% if (!compact) { %>
          <td class="col-date" title="<%= formatDate(item.createdAt) %>"><%= timeAgo(item.createdAt) %></td>
          <td class="col-place"><span class="listing-place"><%= placeLabel(item) %></span></td>
        <% } %>
        <td class="col-fav"><%- include('favorite', { item }) %></td>
      </tr>
    <% }) %>
  </tbody>
</table>

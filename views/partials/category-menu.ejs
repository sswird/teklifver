<details class="box" open data-collapse-mobile>
  <summary class="box-head">Kategoriler <%- icon('chevron-down', { size: 14 }) %></summary>
  <ul class="side-list">
    <li><a class="<%= active === 'all' ? 'is-active' : '' %>" href="/requests"><span class="cat-icon" aria-hidden="true"><%- icon('list', { size: 16 }) %></span>Tüm Talepler <span class="count"><%= Object.values(counts).reduce((a, b) => a + b, 0) %></span></a></li>
    <% allCategories.forEach(category => { const isActive = active === category.name; %>
      <li>
        <a class="side-main <%= isActive ? 'is-active' : '' %>" href="/requests?category=<%= encodeURIComponent(category.name) %>">
          <%- include('cat-icon', { category }) %><%= category.name %>
          <span class="count"><%= counts[category.name] || 0 %></span>
        </a>
        <% if (isActive) { %>
          <div class="side-subs">
            <% category.subs.forEach(([label, term]) => { %>
              <a href="/requests?category=<%= encodeURIComponent(category.name) %>&search=<%= encodeURIComponent(term.trim()) %>"><%= label %></a>
            <% }) %>
          </div>
        <% } %>
      </li>
    <% }) %>
  </ul>
</details>

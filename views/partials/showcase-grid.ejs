<div class="showcase-grid <%= locals.columns ? 'columns-' + columns : '' %>">
  <% items.forEach(item => { %>
    <a class="showcase-item" href="/requests/<%= item._id %>">
      <div class="showcase-photo">
        <% if (item.images && item.images.length) { %>
          <img src="<%= thumb(item.images[0]) %>" alt="<%= item.title %>" loading="lazy" decoding="async" width="240" height="180">
        <% } else { %>
          <span class="no-photo is-placeholder" data-cat="<%= item.category %>">Fotoğraf yok</span>
        <% } %>
        <% if (isUrgent(item)) { %><span class="label label-urgent label-on-photo">ACİL</span><% } %>
      </div>
      <div class="showcase-title"><%= item.title %></div>
      <%# Ana sayfa vitrininin dar hücrelerinde kısa tutar ("90-160 bin TL"), tam tutar ipucunda; başka yerlerde tam tutar ve "TL" tutardan ayrılmaz %>
      <div class="showcase-price" title="<%= budgetLabel(item.budget) %>"><%= locals.shortPrice ? shortBudget(item.budget) : budgetLabel(item.budget).replace(/ TL$/, '\u00a0TL') %></div>
    </a>
  <% }) %>
</div>

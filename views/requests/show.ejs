<%- include('../partials/header') %>

<%
  const isOpen = request.status === 'open';
  const isFav = favoriteIds.includes(String(request._id));
%>

<div class="wrap page">
  <div class="crumbs">
    <a href="/">Ana Sayfa</a> &rsaquo;
    <a href="/requests">Talepler</a> &rsaquo;
    <a href="<%= categoryUrl(request.category) %>"><%= request.category %></a>
    <% if (request.city) { %>&rsaquo; <a href="<%= categoryCityUrl(request.category, request.city) %>"><%= request.city %></a><% } %>
  </div>

  <% if (isOwner && ['open', 'in_progress', 'completed'].includes(request.status)) {
    const chosenFirm = ['in_progress', 'completed'].includes(request.status);
    const steps = [
      ['Talep yayında', true],
      [bids.length ? `${bids.length} teklif geldi` : 'Teklif bekleniyor', bids.length > 0],
      ['Firma seçildi', chosenFirm],
      ['İş tamamlandı', request.status === 'completed']
    ];
  %>
    <ol class="request-steps" aria-label="Talebin durumu">
      <% steps.forEach(([label, done], index) => { %><li class="<%= done ? 'is-done' : '' %>"><% if (index === 1 && bids.length) { %><a href="#teklifler"><%= label %></a><% } else { %><%= label %><% } %></li><% }) %>
    </ol>
  <% } %>
  <div class="detail-title">
    <div class="detail-heading">
      <h1><%= request.title %></h1>
      <% if (isUrgent(request)) { %><span class="label label-urgent">ACİL</span><% } %>
      <% const questionCount = (request.questions || []).length; %>
      <p class="detail-meta">Talep No <strong><%= request.no %></strong> · <a href="#teklifler"><%= bids.length %> teklif</a><% if (questionCount || (isOpen && !isExpired(request))) { %> · <a href="#soru-cevap"><%= questionCount %> soru</a><% } %> · <%= request.viewCount %> görüntülenme<% if (similar.length) { %> · <a href="#benzer">benzer talepler</a><% } %></p>
    </div>
    <div class="detail-actions">
      <% if (currentUser) { %>
        <form class="fav-form" action="/requests/<%= request._id %>/favorite" method="POST">
          <input type="hidden" name="next" value="<%= currentUrl %>">
          <button class="link-button <%= isFav ? 'is-active' : '' %>" type="submit">
            <%- icon('heart', { size: 13 }) %><span data-fav-label><%= isFav ? 'Favorilerden Çıkar' : 'Favorilerime Ekle' %></span>
          </button>
        </form>
      <% } else { %>
        <a class="link-button" href="/login?next=<%= encodeURIComponent(currentUrl) %>"><%- icon('heart', { size: 13 }) %>Favorilerime Ekle</a>
      <% } %>
      <details class="share-menu" data-share-title="<%= request.title %>">
        <summary class="link-button"><%- icon('send', { size: 13 }) %>Paylaş <%- icon('chevron-down', { size: 11 }) %></summary>
        <div class="share-panel">
          <button class="share-item" type="button" data-copy-link><%- icon('link', { size: 15 }) %><span>Bağlantıyı Kopyala</span></button>
          <a class="share-item" target="_blank" rel="noopener" href="https://wa.me/?text=<%= encodeURIComponent(request.title + ' ' + pageUrl) %>"><%- icon('message-circle', { size: 15 }) %>WhatsApp</a>
          <a class="share-item" target="_blank" rel="noopener" href="https://twitter.com/intent/tweet?text=<%= encodeURIComponent(request.title) %>&url=<%= encodeURIComponent(pageUrl) %>"><%- icon('send', { size: 15 }) %>X</a>
          <a class="share-item" href="mailto:?subject=<%= encodeURIComponent(request.title) %>&body=<%= encodeURIComponent(pageUrl) %>"><%- icon('mail', { size: 15 }) %>E-posta</a>
        </div>
      </details>
      <button class="link-button" type="button" data-print><%- icon('printer', { size: 13 }) %>Yazdır</button>
    </div>
  </div>

  <% if (isExpired(request)) { %>
    <div class="alert alert-error">Bu talebin son tarihi geçti, yeni teklif alınmıyor.</div>
  <% } else if (request.status === 'removed') { %>
    <div class="alert alert-error">Bu talep yönetici tarafından yayından kaldırıldı.</div>
  <% } else if (request.status === 'cancelled') { %>
    <div class="alert alert-error">Bu talep sahibi tarafından kapatıldı.</div>
  <% } %>

  <% const hasPhotos = request.images && request.images.length > 0; %>
  <div class="detail-main <%= hasPhotos ? '' : 'no-photos' %>">
    <% if (hasPhotos) { %>
    <div>
        <a class="gallery-main" href="<%= request.images[0] %>" target="_blank" rel="noopener">
          <img src="<%= request.images[0] %>" alt="<%= request.title %>" fetchpriority="high" decoding="async">
          <% if (request.images.length > 1) { %>
            <button class="gallery-nav gallery-prev" type="button" data-step="-1" aria-label="Önceki fotoğraf">&lsaquo;</button>
            <button class="gallery-nav gallery-next" type="button" data-step="1" aria-label="Sonraki fotoğraf">&rsaquo;</button>
          <% } %>
          <span class="gallery-count">1 / <%= request.images.length %></span>
        </a>
        <% if (request.images.length > 1) { %>
          <div class="gallery-thumbs">
            <% request.images.forEach((image, index) => { %>
              <button class="gallery-thumb" type="button" data-full="<%= image %>" aria-label="<%= index + 1 %>. fotoğraf" aria-current="<%= index === 0 %>">
                <img src="<%= thumb(image) %>" alt="" loading="lazy" decoding="async" width="96" height="72">
              </button>
            <% }) %>
          </div>
        <% } %>
    </div>
    <% } %>

    <div>
      <div class="price-big"><%= budgetLabel(request.budget) %></div>
      <div class="place-line">
        <% if (request.city) { %>
          <a href="<%= cityUrl(request.city) %>"><%= request.city %></a><%= request.location ? ' / ' + request.location : '' %>
        <% } else { %>
          <%= request.location || 'Konum belirtilmemiş' %>
        <% } %>
      </div>
      <p class="prose detail-desc"><%= request.description %></p>

      <table class="info-table">
        <tr><td>Talep No</td><td><strong><%= request.no %></strong></td></tr>
        <tr><td>Talep Tarihi</td><td><%= formatDate(request.createdAt) %></td></tr>
        <% const requestCategory = allCategories.find(entry => entry.name === request.category); %>
        <tr><td>Kategori</td><td><a class="cat-link" href="<%= categoryUrl(request.category) %>"><% if (requestCategory) { %><%- include('../partials/cat-icon', { category: requestCategory }) %><% } %><%= request.category %></a></td></tr>
        <tr><td>Son Tarih</td><td><%= request.deadline ? formatDate(request.deadline) : 'Belirtilmemiş' %><% if (request.deadline && isOpen && !isExpired(request)) { %> <span class="muted small">(<span data-deadline="<%= new Date(request.deadline).toISOString() %>"><%= timeLeft(request.deadline) %></span> kaldı)</span><% } %></td></tr>
        <% if (request.discoveryTime) { %>
          <tr><td>Keşif</td><td><%= request.discoveryTime %></td></tr>
        <% } %>
        <tr><td>Durum</td><td><%- include('../partials/status', { status: requestStatus[request.status] }) %></td></tr>
        <tr><td>Teklif Sayısı</td><td><%= bids.length %></td></tr>
        <tr><td>Görüntülenme</td><td><%= request.viewCount %></td></tr>
        <% if (averages) { %>
          <tr><td>Kategori Ort. Teklif</td><td><%= money(averages.amount) %> <span class="muted small">(<%= averages.days %> gün, <%= averages.total %> teklif)</span></td></tr>
        <% } %>
      </table>
    </div>

    <div class="detail-owner">
      <div class="side-card">
        <div class="side-card-head">Talep Sahibi</div>
        <div class="side-card-body">
          <strong><%= isOwner || (currentUser && currentUser.isAdmin) ? request.customer.name : shortName(request.customer.name) %></strong>
          <div class="muted small">Üyelik: <%= memberSince(request.customer.createdAt) %></div>
          <div class="small"><%= ownerOpenCount %> açık talep</div>
        </div>
      </div>

      <% if (contact) { %>
        <div class="side-card">
          <div class="side-card-head">İletişim Bilgileri</div>
          <div class="side-card-body">
            <div class="contact-row"><strong><%= contact.name %></strong></div>
            <div class="contact-row"><a href="mailto:<%= contact.email %>"><%= contact.email %></a></div>
            <% if (contact.phone) { const phone = phoneLinks(contact.phone); %>
              <div class="contact-row"><%= phone.display %></div>
              <div class="contact-actions">
                <a class="btn btn-sm" href="<%= phone.tel %>">Ara</a>
                <% if (phone.whatsapp) { %>
                  <a class="btn btn-sm" target="_blank" rel="noopener" href="<%= phone.whatsapp %>?text=<%= encodeURIComponent('Merhaba, TeklifVer\'deki "' + request.title + '" talebi için yazıyorum.') %>">WhatsApp</a>
                <% } %>
              </div>
            <% } %>
          </div>
        </div>
      <% } %>

      <% if (currentUser && currentUser.role === 'company' && (isOpen || userBid)) { %>
        <a class="btn btn-navy btn-block" style="margin-bottom:10px" href="/messages/<%= request._id %>/<%= request.customer._id %>">Talep Sahibine Mesaj Gönder</a>
      <% } %>

      <% if (isOwner && isOpen) { %>
        <div class="side-card">
          <div class="side-card-head">Talebi Yönet</div>
          <div class="side-card-body">
            <a class="btn btn-block" href="/requests/<%= request._id %>/edit">Düzenle</a>
            <form action="/requests/<%= request._id %>/close" method="POST"
              data-confirm="Talep yayından kalkacak ve bekleyen teklifler reddedilecek." data-confirm-label="Talebi Kapat">
              <button class="btn btn-block" type="submit">Talebi Kapat</button>
            </form>
            <form action="/requests/<%= request._id %>?_method=DELETE" method="POST"
              data-confirm="Bu talep ve gelen tüm teklifler kalıcı olarak silinecek." data-confirm-label="Sil" data-confirm-tone="danger">
              <button class="btn btn-danger-quiet btn-block" type="submit">Talebi Sil</button>
            </form>
          </div>
        </div>
      <% } else if (isOwner && request.status === 'in_progress') { %>
        <div class="side-card">
          <div class="side-card-head">İşi Tamamla</div>
          <div class="side-card-body">
            <form class="form" action="/bids/complete/<%= request._id %>" method="POST"
              data-confirm="Talep tamamlandı olarak işaretlenecek. Bu işlem geri alınamaz." data-confirm-label="Tamamla">
              <div class="field">
                <span class="field-label">Firmayı puanlayın</span>
                <fieldset class="rating-stars">
                  <legend class="visually-hidden">Puan</legend>
                  <% for (let i = 5; i >= 1; i--) { %>
                    <input type="radio" name="rating" value="<%= i %>" id="star<%= i %>">
                    <label for="star<%= i %>"><span class="visually-hidden"><%= i %> yıldız</span><%- icon('star', { size: 20 }) %></label>
                  <% } %>
                </fieldset>
              </div>
              <div class="field">
                <label class="field-label" for="reviewComment">Yorumunuz <span class="optional">İsteğe bağlı</span></label>
                <textarea class="textarea" id="reviewComment" name="comment" rows="3" maxlength="1000"></textarea>
              </div>
              <button class="btn btn-primary btn-block" type="submit">Tamamlandı</button>
            </form>
            <% if (request.acceptedBid) { %>
              <form action="/bids/<%= request.acceptedBid %>/cancel" method="POST"
                data-confirm="Anlaşma iptal edilecek. Talep yeniden yayına girer, diğer teklifler tekrar değerlendirmeye alınır." data-confirm-label="Anlaşmayı İptal Et" data-confirm-tone="danger">
                <button class="btn btn-sm btn-danger-quiet btn-block" type="submit">Anlaşmayı İptal Et</button>
              </form>
            <% } %>
          </div>
        </div>
      <% } else if (isOwner && ['completed', 'cancelled'].includes(request.status)) { %>
        <% if (request.status === 'completed' && !review && request.acceptedBid) { %>
          <div class="side-card">
            <div class="side-card-head">Firmayı Değerlendirin</div>
            <div class="side-card-body">
              <form class="form" action="/bids/review/<%= request._id %>" method="POST">
                <fieldset class="rating-stars">
                  <legend class="visually-hidden">Puan</legend>
                  <% for (let i = 5; i >= 1; i--) { %>
                    <input type="radio" name="rating" value="<%= i %>" id="star<%= i %>" required>
                    <label for="star<%= i %>"><span class="visually-hidden"><%= i %> yıldız</span><%- icon('star', { size: 20 }) %></label>
                  <% } %>
                </fieldset>
                <label class="field-label" for="reviewComment">Yorumunuz <span class="optional">İsteğe bağlı</span></label>
                <textarea class="textarea" id="reviewComment" name="comment" rows="3" maxlength="1000"></textarea>
                <button class="btn btn-primary btn-block" type="submit">Gönder</button>
              </form>
            </div>
          </div>
        <% } %>
        <div class="side-card">
          <div class="side-card-head">Yeniden Yayınla</div>
          <div class="side-card-body">
            <p class="small muted">Aynı bilgilerle yeni bir talep açılır.</p>
            <form action="/requests/<%= request._id %>/republish" method="POST">
              <button class="btn btn-block" type="submit">Yeniden Yayınla</button>
            </form>
          </div>
        </div>
      <% } else if (userBid) { %>
        <div class="side-card">
          <div class="side-card-head">Teklifiniz</div>
          <div class="side-card-body">
            <div class="price-big" style="font-size:16px"><%= money(userBid.amount) %></div>
            <div class="small"><%= userBid.deliveryTime %> gün</div>
            <%- include('../partials/status', { status: bidStatus[userBid.status] }) %>
            <% if (isOpen && userBid.status === 'pending') { %>
              <a class="btn btn-sm btn-block" href="#teklif-duzenle">Teklifi Düzenle</a>
              <form action="/bids/<%= userBid._id %>/withdraw" method="POST"
                data-confirm="Teklifiniz geri çekilecek." data-confirm-label="Geri Çek" data-confirm-tone="danger">
                <button class="btn btn-sm btn-danger-quiet btn-block" type="submit">Teklifi Geri Çek</button>
              </form>
            <% } else if (userBid.status === 'accepted' && request.status === 'in_progress') { %>
              <form action="/bids/<%= userBid._id %>/cancel" method="POST"
                data-confirm="İşi bırakırsanız talep yeniden yayına girer ve bu talebe tekrar teklif veremezsiniz." data-confirm-label="İşi Bırak" data-confirm-tone="danger">
                <button class="btn btn-sm btn-danger-quiet btn-block" type="submit">İşi Bırak</button>
              </form>
            <% } %>
          </div>
        </div>
      <% } else if (isOpen && !isExpired(request) && currentUser && currentUser.role === 'company') { %>
        <a class="btn btn-primary btn-block" href="#teklif-ver">Teklif Ver</a>
      <% } else if (isOpen && !isExpired(request) && !currentUser) { %>
        <a class="btn btn-primary btn-block" href="/login?next=<%= encodeURIComponent('/requests/' + request._id + '#teklif-ver') %>">Teklif Ver</a>
        <p class="small muted" style="margin:5px 0 10px">Teklif vermek için firma hesabıyla giriş yapmalısınız.</p>
      <% } %>

      <% if (!isOwner && !(currentUser && currentUser.role === 'company')) { %>
        <div class="side-card">
          <div class="side-card-head">Benzer bir iş mi yaptıracaksınız?</div>
          <div class="side-card-body small">
            <p>Talebinizi yazın, <%= request.category %> firmaları size de fiyat göndersin.</p>
            <a class="btn btn-block" href="/requests/new?<%= new URLSearchParams({ category: request.category, ...(request.city ? { city: request.city } : {}) }).toString() %>">Benzer Talep Ver</a>
          </div>
        </div>
      <% } %>

      <div class="side-card side-card-warn">
        <div class="side-card-head"><%- icon('shield-alert', { size: 14 }) %> Güvenlik Uyarısı</div>
        <div class="side-card-body small">
          Tüm ödemeyi iş bitmeden yapmayın. İşi ve fiyatı yazılı netleştirin. <a href="/guvenli-hizmet">Ayrıntılar</a>
        </div>
      </div>

      <% if (currentUser && !isOwner) { %>
        <details class="report-box">
          <summary><%- icon('flag', { size: 12 }) %> Bu talebi şikayet et</summary>
          <% if (alreadyReported) { %>
            <p class="small muted">Bu talebi şikayet ettiniz, inceleniyor.</p>
          <% } else { %>
            <form class="form" action="/requests/<%= request._id %>/report" method="POST">
              <select class="select" name="reason" aria-label="Şikayet nedeni" required>
                <option value="">Neden seçin</option>
                <% reportReasons.forEach(reason => { %><option value="<%= reason %>"><%= reason %></option><% }) %>
              </select>
              <textarea class="textarea" name="note" rows="2" maxlength="500" placeholder="Açıklama (isteğe bağlı)" aria-label="Açıklama"></textarea>
              <button class="btn btn-sm" type="submit">Gönder</button>
            </form>
          <% } %>
        </details>
      <% } %>
    </div>
  </div>

  <div id="recentData" hidden
    data-url="/requests/<%= request._id %>"
    data-title="<%= request.title %>"
    data-image="<%= request.images && request.images.length ? request.images[0] : '' %>"
    data-budget="<%= budgetLabel(request.budget) %>"></div>

  <% if (userBid && isOpen && userBid.status === 'pending') { %>
    <section class="box" id="teklif-duzenle">
      <div class="box-head">Teklifimi Düzenle</div>
      <div class="box-body">
        <form class="form" action="/bids/<%= userBid._id %>/edit" method="POST" style="max-width:560px">
          <div class="field-row">
            <div class="field">
              <label class="field-label" for="editAmount">Tutar</label>
              <div class="input-wrap input-wrap-suffix">
                <span class="input-suffix">TL</span>
                <input class="input" type="number" id="editAmount" name="amount" min="1" step="1" value="<%= userBid.amount %>" required>
              </div>
            </div>
            <div class="field">
              <label class="field-label" for="editDays">Teslim süresi</label>
              <div class="input-wrap">
                <input class="input" type="number" id="editDays" name="deliveryTime" min="1" step="1" value="<%= userBid.deliveryTime %>" required>
                <span class="input-suffix">gün</span>
              </div>
            </div>
          </div>
          <div class="field">
            <label class="field-label" for="editDescription">Açıklama</label>
            <textarea class="textarea" id="editDescription" name="description" rows="3" maxlength="3000" required><%= userBid.description %></textarea>
          </div>
          <div class="form-actions"><button class="btn btn-primary" type="submit">Teklifi Güncelle</button></div>
        </form>
      </div>
    </section>
  <% } %>

  <% if (isOpen && !isExpired(request) && currentUser && currentUser.role === 'company' && !userBid) { %>
    <section class="box" id="teklif-ver">
      <div class="box-head">Teklif Ver</div>
      <div class="box-body">
        <% if (allowance && allowance.limited && allowance.left === 0) { %>
          <p class="box-note">Bu ayki teklif hakkınız doldu. Hakkınız ayın ilk günü yenilenir. <a href="/dashboard/plans">Paketlere bakın</a></p>
        <% } else { %>
        <form class="form" action="/bids" method="POST" style="max-width:560px">
          <input type="hidden" name="requestId" value="<%= request._id %>">
          <p class="field-hint">
            Müşterinin bütçesi: <strong><%= budgetLabel(request.budget) %></strong>
            <% if (averages) { %><br>Bu kategorideki tekliflerin ortalaması <strong><%= money(averages.amount) %></strong>, <strong><%= averages.days %> gün</strong>.<% } %>
          </p>
          <div class="field-row">
            <div class="field">
              <label class="field-label" for="amount">Tutar</label>
              <div class="input-wrap input-wrap-suffix">
                <span class="input-suffix">TL</span>
                <input class="input" type="number" id="amount" name="amount" min="1" step="1" inputmode="numeric" required>
              </div>
            </div>
            <div class="field">
              <label class="field-label" for="deliveryTime">Teslim süresi</label>
              <div class="input-wrap">
                <input class="input" type="number" id="deliveryTime" name="deliveryTime" min="1" step="1" inputmode="numeric" required>
                <span class="input-suffix">gün</span>
              </div>
            </div>
          </div>
          <div class="field">
            <label class="field-label" for="bidDescription">Açıklama
              <% if (lastBidText) { %><button class="link-button" type="button" data-fill-target="bidDescription" data-fill-text="<%= lastBidText %>">Son teklif metnimi kullan</button><% } %>
            </label>
            <textarea class="textarea" id="bidDescription" name="description" rows="4" maxlength="3000" placeholder="Fiyata neler dahil, ne zaman başlarsınız, ödemeyi nasıl istersiniz?" required></textarea>
          </div>
          <div class="form-actions">
            <button class="btn btn-primary" type="submit">Teklifi Gönder</button>
            <% if (allowance && allowance.limited) { %><span class="small muted">Bu ay <%= allowance.left %> teklif hakkınız kaldı.</span><% } %>
          </div>
        </form>
        <% } %>
      </div>
    </section>
  <% } %>

  <section class="box">
    <div class="box-head">
      Gelen Teklifler (<%= bids.length %>)
      <% if (bids.length > 1 && canSeeBids) { %>
        <span class="sort-links">
          Sırala:
          <a class="<%= bidSort === 'amount' ? 'is-active' : '' %>" href="?bidSort=amount#teklifler">Fiyat</a>
          <a class="<%= bidSort === 'days' ? 'is-active' : '' %>" href="?bidSort=days#teklifler">Süre</a>
          <a class="<%= bidSort === 'rating' ? 'is-active' : '' %>" href="?bidSort=rating#teklifler">Puan</a>
        </span>
      <% } %>
    </div>
    <span id="teklifler"></span>
    <% if (bids.length && !canSeeBids) { %><p class="box-note">Rekabet adil kalsın diye teklif tutarları ve açıklamalar yalnızca talep sahibine görünür.</p><% } %>
    <% if (bidSummary) { %>
      <p class="box-note bid-summary"><%= bidSummary.count %> bekleyen teklif: en düşük <strong><%= money(bidSummary.lowest) %></strong>, ortalama <strong><%= money(bidSummary.average) %></strong>, en kısa süre <strong><%= bidSummary.fastest %> gün</strong>.</p>
    <% } %>
    <% if (bids.length === 0) { %>
      <div class="empty">Bu talebe henüz teklif verilmedi.</div>
    <% } else { %>
      <table class="listing-table bid-table">
        <thead>
          <tr>
            <th>Firma</th>
            <% if (canSeeBids) { %>
              <th>Açıklama</th>
              <th class="col-budget">Tutar</th>
              <th class="col-date">Süre</th>
            <% } else { %>
              <th>Teklif</th>
            <% } %>
            <th class="col-date">Tarih</th>
            <th class="col-status">Durum</th>
            <% if (isOwner && isOpen) { %><th><span class="visually-hidden">İşlem</span></th><% } %>
          </tr>
        </thead>
        <tbody>
          <% bids.forEach(bid => { %>
            <tr class="bid-row <%= bid.status === 'accepted' ? 'is-accepted' : '' %> <%= bid.status === 'rejected' ? 'is-rejected' : '' %>">
              <td style="width:170px">
                <a class="bid-company" href="/companies/<%= bid.company._id %>"><%= bid.company.companyName || bid.company.name %></a>
                <% if (bid.company.verified) { %><%- include('../partials/verified') %><% } %>
                <div class="firm-badges"><%- include('../partials/firm-badges', { badges: bidBadges.get(String(bid.company._id)) }) %></div>
                <% if (bid.company.ratingCount > 0) { %>
                  <% if (bidSummary && bid.status === 'pending' && bid.company.rating === bidSummary.bestRating) { %><span class="tag-lowest">En yüksek puan</span><% } %>
                  <span class="bid-rating"><%- icon('star', { size: 12, class: 'star' }) %> <%= ratingLabel(bid.company.rating) %> (<%= bid.company.ratingCount %>)</span>
                <% } else { %>
                  <span class="bid-rating">Puan yok</span>
                <% } %>
                <% if (isOwner) { %>
                  <a class="small" href="/messages/<%= request._id %>/<%= bid.company._id %>">Mesaj Gönder</a>
                <% } %>
              </td>
              <% if (bid.hidden) { %>
              <td><span class="muted small">Gizli</span></td>
              <% } else if (!canSeeBids) { %>
              <td><strong><%= money(bid.amount) %></strong>, <%= bid.deliveryTime %> gün <span class="small muted">(sizin teklifiniz)</span><div class="bid-text"><%= bid.description %></div></td>
              <% } else { %>
              <td><div class="bid-text"><%= bid.description %></div></td>
              <td class="col-budget">
                <%= money(bid.amount) %>
                <% if (lowestAmount !== null && bid.status === 'pending' && bid.amount === lowestAmount) { %>
                  <div class="tag-lowest">En düşük</div>
                <% } %>
              </td>
              <td class="col-date">
                <%= bid.deliveryTime %> gün
                <% if (bidSummary && bid.status === 'pending' && bid.deliveryTime === bidSummary.fastestTag) { %><div class="tag-lowest">En hızlı</div><% } %>
              </td>
              <% } %>
              <td class="col-date"><%= formatDate(bid.createdAt) %></td>
              <td class="col-status"><%- include('../partials/status', { status: bidStatus[bid.status] }) %></td>
              <% if (isOwner && isOpen) { %>
                <td style="width:130px">
                  <% if (bid.status === 'pending') { %>
                    <div class="bid-actions">
                      <form action="/bids/<%= bid._id %>/accept" method="POST"
                        data-confirm="Bu teklifi kabul edince diğer teklifler reddedilir ve iletişim bilgileriniz firmayla paylaşılır." data-confirm-label="Kabul Et">
                        <button class="btn btn-primary btn-sm" type="submit">Kabul Et</button>
                      </form>
                      <form action="/bids/<%= bid._id %>/reject" method="POST"
                        data-confirm="Bu teklif reddedilecek." data-confirm-label="Reddet" data-confirm-tone="danger">
                        <button class="btn btn-sm" type="submit">Reddet</button>
                      </form>
                    </div>
                  <% } %>
                </td>
              <% } %>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </section>

  <% const questions = request.questions || []; const canAsk = isOpen && !isExpired(request); %>
  <% if (questions.length || canAsk) { %>
  <section class="box" id="soru-cevap">
    <div class="box-head">Sorular ve Cevaplar (<%= questions.length %>)</div>
    <div class="box-body">
      <% if (!questions.length) { %>
        <p class="muted small">Henüz soru sorulmadı. Firmalar teklif vermeden önce buradan soru sorabilir; soru ve cevaplar herkese açıktır.</p>
      <% } else { %>
        <ol class="qa-list">
          <% questions.forEach(item => { %>
            <li class="qa-item">
              <div class="qa-question">
                <span class="qa-who"><%= item.askerName || 'Firma' %></span> <span class="muted small"><%= timeAgo(item.createdAt) %></span>
                <p><%= item.question %></p>
              </div>
              <% if (item.answer) { %>
                <div class="qa-answer">
                  <span class="qa-who">Talep sahibi</span> <span class="muted small"><%= timeAgo(item.answeredAt || item.createdAt) %></span>
                  <p><%= item.answer %></p>
                </div>
              <% } else if (isOwner && isOpen) { %>
                <form class="qa-reply" action="/requests/<%= request._id %>/questions/<%= item._id %>/answer" method="POST">
                  <label class="visually-hidden" for="answer-<%= item._id %>">Cevabınız</label>
                  <input class="input" id="answer-<%= item._id %>" name="answer" maxlength="1000" placeholder="Cevabınızı yazın" required>
                  <button class="btn btn-sm btn-primary" type="submit">Cevapla</button>
                </form>
              <% } else { %>
                <p class="qa-waiting small muted">Cevap bekleniyor</p>
              <% } %>
            </li>
          <% }) %>
        </ol>
      <% } %>

      <% if (canAsk && currentUser && currentUser.role === 'company') { %>
        <form class="qa-form" action="/requests/<%= request._id %>/questions" method="POST">
          <label class="field-label" for="questionInput">Talep sahibine soru sorun</label>
          <div class="qa-row">
            <input class="input" id="questionInput" name="question" maxlength="500" placeholder="Örneğin: Malzemeyi siz mi alacaksınız?" required>
            <button class="btn" type="submit">Sor</button>
          </div>
          <p class="field-hint">Soru ve cevap herkese açık görünür; telefon veya e-posta yazmayın.</p>
        </form>
      <% } else if (canAsk && !currentUser) { %>
        <p class="small muted"><a href="/login?next=<%= encodeURIComponent(currentUrl + '#soru-cevap') %>">Firma hesabıyla giriş yapın</a>, talep sahibine soru sorun.</p>
      <% } %>
    </div>
  </section>
  <% } %>

  <% if (review) { %>
    <section class="box">
      <div class="box-head">Müşteri Değerlendirmesi</div>
      <div class="box-body">
        <div><%- icon('star', { size: 13, class: 'star' }) %> <strong><%= review.rating %></strong> / 5</div>
        <% if (review.comment) { %><p class="prose" style="margin-top:4px"><%= review.comment %></p><% } %>
        <% if (review.reply && review.reply.text) { %><p class="review-reply"><strong>Firmanın cevabı:</strong> <%= review.reply.text %></p><% } %>
      </div>
    </section>
  <% } %>

  <%- include('../partials/ad', { format: 'leaderboard' }) %>

  <% if (similar.length) { %>
    <section class="box" id="benzer">
      <div class="box-head">Benzer Talepler <a href="<%= categoryUrl(request.category) %>">Tümü</a></div>
      <%- include('../partials/listing-table', { items: similar.slice(0, 5) }) %>
    </section>
  <% } %>
</div>

<%- include('../partials/footer') %>

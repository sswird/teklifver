<% const priceHints = locals.priceHints || {}; %>
<fieldset class="form-step">
<legend class="form-step-head"><span class="form-step-no" aria-hidden="true">1</span>İşinizi anlatın</legend>
<div class="field <%= errors.category ? 'has-error' : '' %>">
  <label class="field-label" for="category">Kategori</label>
  <div class="cat-picker" role="group" aria-label="Kategori seçin" data-cat-picker hidden>
    <% categories.forEach(category => { %>
      <button class="cat-pick" type="button" data-value="<%= category.name %>" aria-pressed="<%= form.category === category.name %>"><%- include('../partials/cat-icon', { category }) %><span><%= category.name %></span></button>
    <% }) %>
  </div>
  <select class="select" id="category" name="category" data-guessed="<%= locals.guessedCategory || '' %>" required>
    <option value="" disabled <%= form.category ? '' : 'selected' %>>Seçiniz</option>
    <% categories.forEach(category => { %>
      <option value="<%= category.name %>" data-tip="<%= requestTips[category.name] || '' %>" data-keywords="<%= category.keywords %>" data-example-title="<%= categoryContent[category.name] ? categoryContent[category.name].example.title : '' %>" data-example-text="<%= categoryContent[category.name] ? categoryContent[category.name].example.text : '' %>" data-price="<%= priceHints[category.name] && priceHints[category.name].total >= 4 ? budgetLabel({ min: priceHints[category.name].typicalLow, max: priceHints[category.name].typicalHigh }) : '' %>" <%= form.category === category.name ? 'selected' : '' %>><%= category.name %></option>
    <% }) %>
  </select>
  <p class="field-hint" id="categoryGuess" <%= locals.guessedCategory ? '' : 'hidden' %>>Yazdığınıza göre seçtik, uymuyorsa değiştirin.</p>
  <% if (errors.category) { %><p class="field-error"><%= errors.category %></p><% } %>
  <div class="tip-box" id="categoryTip" hidden>
    <span>Firmalar en çok şunları sorar. Açıklamaya başlık olarak ekleyebilirsiniz.</span>
    <button class="btn btn-sm" type="button" id="categoryTipAdd">Soruları Ekle</button>
  </div>
</div>

<div class="field <%= errors.title ? 'has-error' : '' %>">
  <label class="field-label" for="title">Talep başlığı</label>
  <input class="input" type="text" id="title" name="title" value="<%= form.title %>" maxlength="200" placeholder="Örneğin: Mutfak dolabı kapakları değişecek" required>
  <% if (errors.title) { %><p class="field-error"><%= errors.title %></p><% } %>
</div>

<div class="field <%= errors.description ? 'has-error' : '' %>">
  <label class="field-label" for="description">Açıklama</label>
  <textarea class="textarea" id="description" name="description" rows="7" maxlength="5000" placeholder="Ölçü, kat, malzeme, ne zaman başlanacağı gibi firmaların soracağı şeyleri yazın." required><%= form.description %></textarea>
  <p class="field-hint">Ölçü, malzeme ve zaman gibi ayrıntıları yazarsanız teklifler daha isabetli olur. Telefon numaranızı buraya yazmayın; teklifi kabul edince firma görür.</p>
  <% if (errors.description) { %><p class="field-error"><%= errors.description %></p><% } %>
</div>
</fieldset>

<fieldset class="form-step">
<legend class="form-step-head"><span class="form-step-no" aria-hidden="true">2</span>Nerede, ne zaman? <span class="optional">İsteğe bağlı</span></legend>
<div class="field-row is-pair">
  <div class="field <%= errors.city ? 'has-error' : '' %>">
    <label class="field-label" for="city">İl</label>
    <select class="select" id="city" name="city">
      <option value="">Seçiniz</option>
      <% allCities.forEach(city => { %>
        <option value="<%= city %>" <%= form.city === city ? 'selected' : '' %>><%= city %></option>
      <% }) %>
    </select>
    <% if (errors.city) { %><p class="field-error"><%= errors.city %></p><% } %>
  </div>
  <div class="field">
    <label class="field-label" for="location">İlçe / semt</label>
    <% const formDistricts = locals.districtsByCity || {}; %>
    <input class="input" type="text" id="location" name="location" maxlength="100" value="<%= form.location %>" list="locationOptions" autocomplete="off" data-districts="<%= JSON.stringify(formDistricts) %>">
    <datalist id="locationOptions">
      <% (formDistricts[form.city] || []).forEach(name => { %><option value="<%= name %>"></option><% }) %>
    </datalist>
  </div>
</div>

<div class="field-row">
  <div class="field <%= errors.deadline ? 'has-error' : '' %>">
    <label class="field-label" for="deadline">Son tarih</label>
    <input class="input" type="date" id="deadline" name="deadline" min="<%= dateInput() %>" value="<%= form.deadline %>">
    <% if (errors.deadline) { %><p class="field-error"><%= errors.deadline %></p><% } %>
  </div>
  <div class="field <%= errors.discoveryTime ? 'has-error' : '' %>">
    <label class="field-label" for="discoveryTime">Keşif için uygun zaman</label>
    <select class="select" id="discoveryTime" name="discoveryTime">
      <option value="">Keşif gerekmiyor</option>
      <% discoveryTimes.forEach(option => { %>
        <option value="<%= option %>" <%= form.discoveryTime === option ? 'selected' : '' %>><%= option %></option>
      <% }) %>
    </select>
    <% if (errors.discoveryTime) { %><p class="field-error"><%= errors.discoveryTime %></p><% } %>
  </div>
</div>

<label class="checkbox urgent-check">
  <input type="checkbox" name="isUrgent" <%= form.isUrgent ? 'checked' : '' %>>
  <span><strong>Acil iş.</strong> Birkaç gün içinde başlanması gerekiyor; talebinizde ACİL etiketi görünür.</span>
</label>
</fieldset>

<fieldset class="form-step">
<legend class="form-step-head"><span class="form-step-no" aria-hidden="true">3</span>Bütçe ve fotoğraf <span class="optional">İsteğe bağlı</span></legend>
<div class="field <%= errors.budget ? 'has-error' : '' %>">
  <div class="field-row is-pair">
    <div class="field">
      <label class="field-label" for="budgetMin">En az bütçe</label>
      <div class="input-wrap input-wrap-suffix">
        <span class="input-suffix">TL</span>
        <input class="input" type="number" id="budgetMin" name="budgetMin" min="0" step="1" inputmode="numeric" value="<%= form.budgetMin %>">
      </div>
    </div>
    <div class="field">
      <label class="field-label" for="budgetMax">En fazla bütçe</label>
      <div class="input-wrap input-wrap-suffix">
        <span class="input-suffix">TL</span>
        <input class="input" type="number" id="budgetMax" name="budgetMax" min="0" step="1" inputmode="numeric" value="<%= form.budgetMax %>">
      </div>
    </div>
  </div>
  <p class="field-hint" id="categoryPrice" hidden></p>
  <% if (errors.budget) { %><p class="field-error"><%= errors.budget %></p><% } %>
</div>

<% if (locals.existingImages && existingImages.length) { %>
  <div class="field">
    <span class="field-label">Mevcut fotoğraflar</span>
    <div class="thumbs">
      <% existingImages.forEach(image => { %>
        <label class="upload-thumb" title="Kaldırmak için tıklayın">
          <input type="checkbox" name="removeImages" value="<%= image %>" aria-label="Bu fotoğrafı kaldır">
          <img src="<%= image %>" alt="">
          <span class="thumb-remove">×</span>
        </label>
      <% }) %>
    </div>
    <p class="field-hint">Kaldırmak istediklerinizi işaretleyin, kaydedince silinir.</p>
  </div>
<% } %>

<% if (locals.guest) { %>
  <p class="field-hint">Fotoğrafları hesabınızı açtıktan sonra, yayınlamadan önce ekleyebilirsiniz.</p>
<% } else { %>
<div class="field <%= errors.images ? 'has-error' : '' %>">
  <span class="field-label">Fotoğraf</span>
  <label class="dropzone">
    <input class="visually-hidden" type="file" id="images" name="images" multiple accept="image/jpeg,image/png,image/gif,image/webp" data-max="<%= maxImages %>">
    <span class="dropzone-title"><%- icon('camera', { size: 22 }) %>Fotoğraf seçin</span>
    <span class="muted small">ya da buraya sürükleyin. En fazla <%= maxImages %> fotoğraf, her biri 5 MB olabilir.</span>
  </label>
  <div class="thumbs" id="imagePreviews"></div>
  <p class="field-error" id="imagesError" <%= errors.images ? '' : 'hidden' %>><%= errors.images || '' %></p>
</div>
<% } %>
</fieldset>

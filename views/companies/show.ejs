<%- include('../partials/header') %>

<% const companyTitle = company.companyName || company.name;
   const firstCategory = allCategories.find(item => (company.categories || []).includes(item.name));
   // Kapak yalnızca firmanın kendi yüklediği iş örneğinden gelir; hazır fotoğraf firmanınmış gibi gösterilmez.
   const cover = (company.portfolio && company.portfolio[0]) || ''; %>

<div class="wrap page">
  <div class="crumbs">
    <a href="/">Ana Sayfa</a> &rsaquo; <a href="/companies">Firma Rehberi</a> &rsaquo; <span><%= companyTitle %></span>
  </div>

  <section class="box company-hero">
    <% if (cover) { %><div class="company-cover"><img src="<%= cover %>" alt="" width="1200" height="300" fetchpriority="high"></div><% } %>
    <div class="company-head">
      <%- include('../partials/company-mark', { company }) %>
      <div>
        <h1><%= companyTitle %> <% if (company.verified) { %><%- include('../partials/verified') %><% } %></h1>
        <div class="meta">
          <% if (company.ratingCount > 0) { %>
            <%- icon('star', { size: 13, class: 'star' }) %> <strong><%= ratingLabel(company.rating) %></strong> (<%= company.ratingCount %> değerlendirme)
          <% } else { %>Henüz değerlendirme yok<% } %>
          <% if (company.address) { %> · <%= company.address %><% } %>
          · Üyelik: <%= memberSince(company.createdAt) %>
          <% if (stats.lastBidAt) { %>· Son teklif: <%= timeAgo(stats.lastBidAt) %><% } %>
          <% if (stats.responseHours !== null) { %>· Genelde <%= responseLabel(stats.responseHours) %> teklif verir<% } %>
        </div>
        <% if (badges && badges.length) { %><div class="firm-badges"><%- include('../partials/firm-badges', { badges }) %></div><% } %>
      </div>
    </div>
    <div class="summary">
      <div><strong><%= stats.bidTotal %></strong><span>Verilen teklif</span></div>
      <div><strong><%= stats.accepted %></strong><span>Kabul edilen</span></div>
      <div><strong><%= stats.completed %></strong><span>Tamamlanan iş</span></div>
      <div><strong><%= stats.avgDays === null ? '-' : stats.avgDays + ' gün' %></strong><span>Ort. teslim süresi</span></div>
    </div>
  </section>

  <section class="box">
    <div class="box-head">Firma Hakkında</div>
    <div class="box-body">
      <p class="prose"><%= company.companyDescription || 'Bu firma henüz tanıtım yazısı eklemedi.' %></p>
      <% if (company.specialties && company.specialties.length) { %>
        <p class="tag-line" style="margin-top:8px"><strong>Hizmetler:</strong> <%= company.specialties.join(', ') %></p>
      <% } %>
      <% if (company.categories && company.categories.length) { %>
        <div class="cat-chips"><strong>Kategoriler:</strong>
          <% company.categories.forEach(name => { const linked = allCategories.find(entry => entry.name === name); %>
            <a class="cat-chip" href="<%= categoryUrl(name) %>"><% if (linked) { %><%- include('../partials/cat-icon', { category: linked }) %><% } %><%= name %></a>
          <% }) %>
        </div>
      <% } %>
      <p class="tag-line" style="margin-top:4px"><strong>Hizmet bölgesi:</strong> <%= company.serviceCities && company.serviceCities.length ? company.serviceCities.join(', ') : 'Tüm Türkiye' %></p>
    </div>
  </section>

  <% if (company.portfolio && company.portfolio.length) { %>
    <section class="box">
      <div class="box-head">İş Örnekleri (<%= company.portfolio.length %>)</div>
      <div class="portfolio-grid">
        <% company.portfolio.forEach(image => { %>
          <a href="<%= image %>" target="_blank" rel="noopener"><img src="<%= thumb(image) %>" alt="<%= companyTitle %> iş örneği" loading="lazy" decoding="async" width="240" height="180"></a>
        <% }) %>
      </div>
    </section>
  <% } %>

  <% if (!inviteOptions.length && !isOwnPage && !(currentUser && currentUser.role === 'company')) { %>
    <section class="box">
      <div class="box-head">Bu Firmadan Teklif Alın</div>
      <div class="box-body">
        <p>Yaptıracağınız işi yazın; <%= companyTitle %> ve aynı alandaki diğer firmalar fiyat ve süre göndersin. Talep verdikten sonra bu sayfadan firmayı talebinize davet edebilirsiniz.</p>
        <a class="btn btn-primary" style="margin-top:10px" href="/requests/new<%= firstCategory ? '?category=' + encodeURIComponent(firstCategory.name) : '' %>">Ücretsiz Talep Ver</a>
      </div>
    </section>
  <% } %>

  <% if (inviteOptions.length) { %>
    <section class="box">
      <div class="box-head">Bu Firmadan Teklif İsteyin</div>
      <div class="box-body">
        <form class="invite-form" method="POST" data-invite="<%= company._id %>">
          <label class="field-label" for="inviteRequest">Açık talebiniz</label>
          <select class="select" id="inviteRequest" required>
            <% inviteOptions.forEach(item => { %><option value="<%= item._id %>"><%= truncate(item.title, 80) %></option><% }) %>
          </select>
          <button class="btn btn-primary" type="submit">Davet Et</button>
        </form>
        <noscript><p class="small muted">Davet göndermek için JavaScript gereklidir.</p></noscript>
      </div>
    </section>
  <% } %>

  <section class="box">
    <div class="box-head">Müşteri Yorumları (<%= reviews.length %>)</div>
    <% if (reviews.length === 0) { %>
      <div class="empty">Bu firma için henüz yorum yazılmadı.</div>
    <% } else { %>
      <ul class="review-list">
        <% reviews.forEach(review => { %>
          <li>
            <div class="review-top">
              <span class="review-stars" role="img" aria-label="<%= review.rating %> yıldız">
                <% for (let i = 1; i <= 5; i += 1) { %><%- icon('star', { size: 13, class: i <= review.rating ? 'star' : 'star-empty' }) %><% } %>
              </span>
              <strong><%= shortName(review.customer.name) %></strong>
              <span class="muted small"><%= formatDate(review.createdAt) %></span>
            </div>
            <% if (review.comment) { %><p class="prose"><%= review.comment %></p><% } %>
            <% if (review.request) { %><a class="small" href="/requests/<%= review.request._id %>"><%= review.request.title %></a><% } %>
            <% if (review.reply && review.reply.text) { %><p class="review-reply"><strong>Firmanın cevabı:</strong> <%= review.reply.text %></p><% } %>
            <% if (isOwnPage) { %>
              <details class="reply-box">
                <summary class="small"><%= review.reply && review.reply.text ? 'Cevabı Düzenle' : 'Cevap Yaz' %></summary>
                <form class="form" action="/companies/reviews/<%= review._id %>/reply" method="POST">
                  <textarea class="textarea" name="reply" rows="2" maxlength="1000" aria-label="Cevabınız"><%= review.reply ? review.reply.text : '' %></textarea>
                  <button class="btn btn-sm" type="submit">Kaydet</button>
                </form>
              </details>
            <% } %>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>

  <section class="box">
    <div class="box-head">Aldığı İşler (<%= jobs.length %>)</div>
    <% if (jobs.length === 0) { %>
      <div class="empty">Bu firmanın henüz kabul edilmiş teklifi yok.</div>
    <% } else { %>
      <table class="listing-table">
        <thead>
          <tr>
            <th class="col-photo"><span class="visually-hidden">Fotoğraf</span></th>
            <th>Talep</th>
            <th class="col-place">İl / İlçe</th>
            <th class="col-date">Tarih</th>
            <th class="col-status">Durum</th>
          </tr>
        </thead>
        <tbody>
          <% jobs.forEach(job => { %>
            <tr>
              <td class="col-photo">
                <a class="thumb" href="/requests/<%= job._id %>" tabindex="-1" aria-hidden="true">
                  <% if (job.images && job.images.length) { %>
                    <img src="<%= thumb(job.images[0]) %>" alt="" loading="lazy" width="120" height="90">
                  <% } else { %>
                    <span class="no-photo">Fotoğraf yok</span>
                  <% } %>
                </a>
              </td>
              <td>
                <a class="listing-title" href="/requests/<%= job._id %>"><%= job.title %></a>
                <div class="listing-sub"><%= job.category %></div>
              </td>
              <td class="col-place"><%= placeLabel(job) %></td>
              <td class="col-date"><%- dateCell(job.createdAt) %></td>
              <td class="col-status"><%- include('../partials/status', { status: requestStatus[job.status] }) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </section>

  <% if (similarFirms.length) { %>
    <section class="box">
      <div class="box-head">Benzer Firmalar<% if (firstCategory) { %> <a href="/companies?category=<%= encodeURIComponent(firstCategory.name) %>">Tüm <%= firstCategory.name %> firmaları</a><% } %></div>
      <ul class="similar-firms">
        <% similarFirms.forEach(firm => { %>
          <li>
            <%- include('../partials/company-mark', { company: firm }) %>
            <div class="similar-body">
              <a class="similar-name" href="/companies/<%= firm._id %>"><%= firm.companyName || firm.name %></a>
              <% if (firm.verified) { %><%- include('../partials/verified') %><% } %>
              <div class="similar-meta"><% if (firm.ratingCount > 0) { %><%- icon('star', { size: 11, class: 'star' }) %> <%= ratingLabel(firm.rating) %> (<%= firm.ratingCount %> yorum)<% } else { %>Henüz yorum yok<% } %><%= firm.address ? ' · ' + firm.address : '' %></div>
              <div class="firm-badges"><%- include('../partials/firm-badges', { badges: similarBadges.get(String(firm._id)) }) %></div>
            </div>
          </li>
        <% }) %>
      </ul>
    </section>
  <% } %>

  <% if (currentUser && !isOwnPage) { %>
    <details class="report-box">
      <summary><%- icon('flag', { size: 12 }) %> Bu firmayı şikayet et</summary>
      <% if (alreadyReported) { %>
        <p class="small muted">Bu firmayı şikayet ettiniz, inceleniyor.</p>
      <% } else { %>
        <form class="form" action="/companies/<%= company._id %>/report" method="POST">
          <select class="select" name="reason" aria-label="Şikayet nedeni" required>
            <option value="">Neden seçin</option>
            <% reportReasons.forEach(reason => { %><option value="<%= reason %>"><%= reason %></option><% }) %>
          </select>
          <textarea class="textarea" name="note" rows="2" maxlength="500" placeholder="Açıklama (isteğe bağlı)" aria-label="Açıklama"></textarea>
          <button class="btn btn-sm" type="submit">Gönder</button>
        </form>
      <% } %>
    </details>
  <% } %>
</div>

<%- include('../partials/footer') %>
